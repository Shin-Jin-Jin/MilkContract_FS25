<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUIProfiles>
    <!-- Hauptcontainer der Seite -->
    <Profile name="mc_mainContainer" extends="fs25_menuContainer" with="anchorMiddleLeft">
        <position value="134px -0.03" />
    </Profile>

    <!-- Ueberschrift ueber der Liste -->
    <Profile name="mc_listHeaderRow" extends="emptyPanel" with="anchorTopLeft" />

    <Profile name="mc_listHeader" extends="fs25_textDefault" with="anchorTopLeft">
        <textSize value="16px" />
        <textBold value="true" />
        <textUpperCase value="true" />
        <textColor value="$preset_colorWhite_50" />
        <textAlignment value="left" />
    </Profile>

    <!-- Linke Spalte: Liste -->
    <Profile name="mc_listContainer" extends="baseReference" with="anchorBottomLeft">
        <position value="0.0 0.06" />
        <size value="0.42 0.66" />
    </Profile>

    <Profile name="mc_listItem" extends="baseReference" with="anchorTopStretchingX alternating">
        <height value="44px"/>
        <imageColor value="$preset_fs25_colorGrey" />
        <imageSelectedColor value="$preset_fs25_colorMainHighlight" />
        <alternateBackgroundColor value="$preset_fs25_colorGreyDark_50" />
    </Profile>

    <Profile name="mc_nameText" extends="fs25_textDefault" with="anchorStretchingYLeft">
        <textBold value="true" />
