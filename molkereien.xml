<?xml version="1.0" encoding="utf-8"?>

<!-- ###################################################################
     MILCHVERTRAG  ::  Molkerei-Definitionen  ::  FS25 Mod-Konzept

     Diese Datei definiert alle waehlbaren Molkereien und die globalen
     Regeln. Rein datengetrieben: neue Molkerei = neuer dairy-Block,
     keine Code-Aenderung noetig. Nur die requirement-Auflagen brauchen
     die passende Pruef-Logik im Script (Gesundheit, Kaelber-Haltedauer).
     #################################################################### -->

<milkContracts version="1">

    <!-- ###############################################################
         GLOBALE EINSTELLUNGEN  (gelten fuer jeden Vertrag)
         ############################################################### -->
    <settings>

        <!-- Herdengesundheit als Bio-Kriterium:
             gleitender Mittelwert ueber den Vertragszeitraum. -->
        <health sampleOnDayChange="true"
                weightByAnimalCount="true"
                acrossAllHusbandries="true" />

        <!-- Finales Modell: Was der Vertrag nicht nimmt (Ueberschuss ueber
             dem Deckel), bleibt im Stall-Lager liegen. KEIN Auto-Marktverkauf
             durch die Mod - der Spieler faehrt Ueberschuss bei Bedarf selbst
             ueber die Spielbasis weg. -->
        <surplus keepInStorage="true" />

        <!-- Zielmenge/Deckel werden periodenbasiert gerechnet und
             skalieren automatisch mit der Monatslaenge (daysPerPeriod).
             referenceDays = Bezugsmonat fuer Prozent-/Literangaben. -->
        <scaling scaleByDaysPerPeriod="true" referenceDays="30" />

        <!-- Zielmenge = geschaetzte Jahresproduktion beim Abschluss
             (aktueller Kuhbestand mal Produktivitaet). -->
        <estimation source="herdAtSigning" horizon="annual" />

    </settings>


    <!-- ###############################################################
         MOLKEREIEN

         Attribut-Referenz pro dairy:

           id           interner Schluessel (eindeutig, kein Leerzeichen)
           title / desc l10n-Keys fuer Anzeige im Menue

         pricing type="market|fixed"
           marketMultiplier   nur bei market  (1.0 = Tagespreis)
           pricePerLiter      nur bei fixed   (EUR pro Liter)

         quota type="none|minimum|maximum"
           percentOfEstimated nur bei minimum (Anteil Jahresschaetzung)
           litersPerMonth     nur bei maximum (Deckel je Bezugsmonat)

         payout interval="monthly|quarterly|yearly"

         penalty factor="x"   nur sinnvoll bei quota=minimum
           pro fehlendem Liter: Vertragspreis mal factor zurueck

         requirements (optional):
           minHerdHealth percent="x"   braucht Gesundheits-Check
           minCalfAge months="x"       braucht Tierverkaufs-Hook
         ############################################################### -->
