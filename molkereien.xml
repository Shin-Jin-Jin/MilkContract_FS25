               title="$l10n_dairy_nordmilch_title"
               desc="$l10n_dairy_nordmilch_desc">
            <pricing type="fixed" pricePerLiter="1.05" />
            <quota   type="minimum" percentOfEstimated="85" percentVariance="10" />
            <payout  interval="halfyearly" />
            <duration months="12" />
            <penalty factor="1.5" />
        </dairy>

        <!-- 3) MARKTKONTOR :: Spekulant -->
